# このファイルを .env.local にコピーして値を入れる（.env.local はGitHubに保存されない）
# どちらも「画面側に置いてよい」公開用の値。service_role キーはここに書かない

# Supabase のプロジェクトURL（Supabase の Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の公開用キー（Publishable key。sb_publishable_ で始まる）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ブランド（food / night）。NIGHT は Phase 4 まで使わない
NEXT_PUBLIC_BRAND=food
